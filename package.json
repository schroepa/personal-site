{
  "name": "personal-site-ptrckschrdtr",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-vercel-headers.mjs --check && node scripts/copy-fonts.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 astro build",
    "postbuild": "node scripts/generate-cv-pdf.mjs && node scripts/generate-og-images.mjs",
    "postinstall": "playwright install chromium && node scripts/copy-fonts.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "tokens": "node scripts/export-tokens.mjs design/figma-variables.json src/styles/tokens.css",
    "headers": "node scripts/build-vercel-headers.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\" \"src/lib/**/*.test.ts\" \"src/scripts/**/*.test.mjs\" \"tests/*.test.mjs\"",
    "test": "npm run test:scripts && npm run test:e2e",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:cross-browser": "CROSS_BROWSER=1 playwright test --project=firefox --project=webkit",
    "qa": "npm run lint && npm run typecheck && npm run build && npm run test:scripts && npx playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource/geist-mono": "5.2.7",
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.18.1",
    "github-slugger": "2.0.0",
    "lenis": "1.3.27",
    "motion": "14.7.1",
    "posthog-js": "^1.373.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@paper-design/shaders-react": "^0.0.77",
    "@playwright/test": "^1.61.1",
    "@remotion/cli": "^4.0.486",
    "@remotion/renderer": "^4.0.486",
    "chrome-launcher": "1.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "lighthouse": "12.8.2",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "remotion": "^4.0.486",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
