---
// Impressum im neuen Design (Figma „Rechtliches“ 243:24, Screen impressum 265:21666). Ein Abschnitt je Pflichtangabe, Texte in src/data/rechtliches.ts.
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import Rechtstext from "@/components/site/Rechtstext.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { IMPRESSUM, NAME } from "@/data/rechtliches"
---

<SiteLayout
  title={`Impressum — ${NAME}`}
  description="Impressum und Anbieterkennzeichnung gemäß § 5 DDG und § 18 Abs. 2 MStV."
  blatt="01/02 Impressum"
>
  <Seitenkopf art="seite" label={IMPRESSUM.label} titel={IMPRESSUM.titel} einleitung={IMPRESSUM.einleitung} />
  {
    IMPRESSUM.abschnitte.map((a) => (
      <Abschnitt id={a.id} label={a.label}>
        <Rechtstext bloecke={a.bloecke} />
      </Abschnitt>
    ))
  }
</SiteLayout>
