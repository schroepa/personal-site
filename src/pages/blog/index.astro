---
// Blog-Übersicht „Gedanken“ (Figma 266:23181 / 266:23730 / 266:24201): Seitenkopf mit Themenfiltern ·
// Neu (jüngster Beitrag, groß) · übrige Beiträge nach Jahren absteigend · Kontakt-Panel.
// Ohne JavaScript sind alle Beiträge sichtbar und die Filter versteckt (html[data-js]); src/scripts/filter.ts blendet aus.
import { getCollection } from "astro:content"
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import ArtikelZeile from "@/components/site/ArtikelZeile.astro"
import Knopf from "@/components/site/Knopf.astro"
import KontaktPanel from "@/components/site/KontaktPanel.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { KONTAKT_EMAIL } from "@/data/kontakt"
import { gruppiereNachJahr, slugVon, themenListe, veroeffentlichte, zeilenMeta } from "@/lib/blog"
import { coverMittel, coverThumbSrc } from "@/lib/cover-image"
import { readingTime } from "@/lib/reading-time"
import { artikelMeta } from "@/lib/startseite"


const sortiert = veroeffentlichte(await getCollection("blog"))
const [neu, ...rest] = sortiert
const gruppen = gruppiereNachJahr(rest)
const themen = themenListe(sortiert)
const tagsAttr = (tags?: string[]) => JSON.stringify(tags ?? [])
---

<SiteLayout
  title="Gedanken — Patrick Schrödter"
  description="Notizen über Systeme, Code und Handwerk: Was ich beim Bauen von Design Systems, Werkzeugen und Interfaces lerne."
  blatt="Übersicht"
>
  <div data-filter-root>
    <Seitenkopf
      art="seite"
      label="Gedanken"
      titel="Notizen über Systeme, Code und Handwerk."
      einleitung="Was ich beim Bauen von Design Systems, Werkzeugen und Interfaces lerne. Ehrlich, aus der Praxis, ohne Hochglanz."
    >
      {
        themen.length > 0 && (
          <div slot="zusatz" class="filter" data-filter-chips role="group" aria-label="Nach Thema filtern">
            <Knopf art="ghost" aria-pressed="true">Alle</Knopf>
            {themen.map((t) => (
              <Knopf art="ghost" aria-pressed="false" data-tag={t}>
                {t}
              </Knopf>
            ))}
          </div>
        )
      }
    </Seitenkopf>

    <div data-filter-liste>
      {
        neu && (
          <div data-gruppe>
            <Abschnitt id="neu" label="Neu" layout="links">
              <div class="zeilen">
                <div data-eintrag data-slug={slugVon(neu.id)} data-tags={tagsAttr(neu.data.tags)}>
                  <ArtikelZeile
                    groesse="gross"
                    meta={artikelMeta(neu.data.tags, readingTime(neu.body ?? ""), neu.data.date)}
                    titel={neu.data.title}
                    auszug={neu.data.description}
                    bild={coverMittel(neu.data.coverImage)}
                    href={`/blog/${slugVon(neu.id)}`}
                  />
                </div>
              </div>
            </Abschnitt>
          </div>
        )
      }
      {
        gruppen.map((g) => (
          <div data-gruppe>
            <Abschnitt id={`jahr-${g.jahr}`} label={String(g.jahr)} layout="links">
              <div class="zeilen">
                {g.eintraege.map((b) => (
                  <div data-eintrag data-slug={slugVon(b.id)} data-tags={tagsAttr(b.data.tags)}>
                    <ArtikelZeile
                      groesse="klein"
                      auszugAnzeigen
                      meta={zeilenMeta(b.data.tags, b.data.date)}
                      titel={b.data.title}
                      auszug={b.data.description}
                      bild={coverThumbSrc(b.data.coverImage)}
                      href={`/blog/${slugVon(b.id)}`}
                    />
                  </div>
                ))}
              </div>
            </Abschnitt>
          </div>
        ))
      }
    </div>
    <p class="text-body leer" role="status" data-filter-leer></p>
  </div>

  <div class="kontakt">
    <KontaktPanel label="Kontakt" email={KONTAKT_EMAIL} />
  </div>
</SiteLayout>

<style>
  /* Themenfilter: Knöpfe in einer umbrechenden Reihe (Figma 266:23243, Abstand 8); ohne JavaScript ausgeblendet */
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--global-size-8);
  }
  :global(html:not([data-js])) .filter {
    display: none;
  }

  /* Der Seitenkopf sitzt bündig unter dem Kopf (Figma 266:23228): Abschnittsabstand oben von <main> aufheben */
  [data-filter-root] {
    margin-block-start: calc(-1 * var(--layout-section-gap));
  }

  /* Eintrag und Gruppe werden per hidden ausgeblendet; die Gruppe ist ein Raster und braucht die Regel ausdrücklich */
  [data-eintrag][hidden],
  [data-gruppe][hidden] {
    display: none;
  }

  /* Zeilen: 40 Abstand (Figma 266:23312) */
  .zeilen {
    display: flex;
    flex-direction: column;
    gap: var(--global-size-40);
  }
  .zeilen > :global(*) {
    min-width: 0;
  }

  /* Statusmeldung bei 0 Treffern (leer, solange Beiträge sichtbar sind, dann ohne Höhe; bleibt im Dokument, damit die Ansage zuverlässig ist) */
  .leer {
    margin: 0;
    color: var(--theme-text-default);
  }

  /* Kontakt: 80 Abstand zum Fuß (die Hauptfläche bringt schon den Abschnittsabstand mit) */
  .kontakt {
    margin-block-end: calc(var(--global-size-80) - var(--layout-section-gap));
  }
</style>
