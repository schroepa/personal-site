---
// Blogartikel im neuen Design. Veröffentlichte Beiträge, jüngste zuerst; Weiterlesen ohne den aktuellen Beitrag.
import { getCollection, render } from "astro:content"
import type { InferGetStaticPropsType } from "astro"
import ArtikelLayout from "@/layouts/ArtikelLayout.astro"
import { ueberschriftenFuerInhalt, veroeffentlichte, weiterlesen } from "@/lib/blog"
import { readingTime } from "@/lib/reading-time"

export async function getStaticPaths() {
  // getStaticPaths wird aus dem Modul herausgehoben: Hilfsfunktionen müssen darin stehen
  const slugVon = (id: string) => id.replace(/\.md$/, "")
  const sortiert = veroeffentlichte(await getCollection("blog"))
  return sortiert.map((post) => ({
    params: { slug: slugVon(post.id) },
    props: {
      post,
      weiter: weiterlesen(sortiert, post.id).map((b) => ({
        slug: slugVon(b.id),
        title: b.data.title,
        description: b.data.description,
        tags: b.data.tags ?? [],
        date: b.data.date,
        coverImage: b.data.coverImage,
      })),
    },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const slugVon = (id: string) => id.replace(/\.md$/, "")
const { post, weiter } = Astro.props as Props
const { Content, headings } = await render(post)
---

<ArtikelLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  coverImage={post.data.coverImage}
  slug={slugVon(post.id)}
  minuten={readingTime(post.body ?? "")}
  eintraege={ueberschriftenFuerInhalt(headings)}
  weiterlesen={weiter}
>
  <Content />
</ArtikelLayout>
