---
// Lebenslauf im neuen Design (Figma 269:1326, Screens 269:1609 / 269:1915 / 269:2180): normale, indexierbare Webseite,
// kein Foto. Seitenkopf mit PDF-Download · Profil · Erfahrung · Projekte · Kompetenzen · Tech Stack · Ausbildung · Sprachen.
// Fakten: src/data/cv.ts (Quelle), Aufbau und Beschriftungen: src/lib/cv.ts. Das PDF (/cv.pdf) entsteht beim Build aus
// dieser Seite (scripts/generate-cv-pdf.mjs) über das @media-print-Stylesheet src/styles/neu-print.css.
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import Knopf from "@/components/site/Knopf.astro"
import NummernListe from "@/components/site/NummernListe.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { cvData } from "@/data/cv"
import { KONTAKT_EMAIL } from "@/data/kontakt"
import { CV_ABSCHNITTE, CV_SEITE, cvEintraege } from "@/lib/cv"
import "@/styles/neu-print.css"

const e = cvEintraege(cvData)
const label = (id: string) => CV_ABSCHNITTE.find((a) => a.id === id)!.label
---

<SiteLayout
  title={`Lebenslauf — ${cvData.name}`}
  description={`Lebenslauf von ${cvData.name}, Senior Product Designer, Design Systems Expert und Design Engineer aus ${cvData.contact.city}.`}
  blatt="Lebenslauf"
>
  <Seitenkopf art="seite" label={CV_SEITE.label} titel={cvData.name} einleitung={`${cvData.title} · ${cvData.contact.city}`}>
    <div slot="zusatz" class="aktionen">
      <Knopf art="primary" href={CV_SEITE.pdfHref} download pfeil="↓">{CV_SEITE.pdfLabel}</Knopf>
      <Knopf art="ghost" href={`mailto:${KONTAKT_EMAIL}`}>E-Mail</Knopf>
    </div>
  </Seitenkopf>

  <Abschnitt id="profil" label={label("profil")}>
    <p class="text-body profil">{cvData.profile}</p>
  </Abschnitt>

  <Abschnitt id="erfahrung" label={label("erfahrung")}>
    <NummernListe eintraege={e.erfahrung} ebene={3} />
  </Abschnitt>

  <Abschnitt id="projekte" label={label("projekte")}>
    <NummernListe eintraege={e.projekte} ebene={3} />
  </Abschnitt>

  <Abschnitt id="kompetenzen" label={label("kompetenzen")}>
    <NummernListe eintraege={e.kompetenzen} ebene={3} />
  </Abschnitt>

  <Abschnitt id="tech-stack" label={label("tech-stack")}>
    <NummernListe eintraege={e.techStack} />
  </Abschnitt>

  <Abschnitt id="ausbildung" label={label("ausbildung")}>
    <NummernListe eintraege={e.ausbildung} ebene={3} />
  </Abschnitt>

  <Abschnitt id="sprachen" label={label("sprachen")}>
    <NummernListe eintraege={e.sprachen} />
  </Abschnitt>
</SiteLayout>

<style>
  .aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--global-size-8);
  }
  .profil {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
