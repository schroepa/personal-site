---
// Projekt-Übersicht „Arbeit“ (Figma 267:21878 / 267:22494 / 267:23020): Seitenkopf mit Themenfiltern ·
// Ausgewählt (Bento mit Projektkarten) · Weitere Projekte (Liste) · Digital Art (Akkordeon) · Kontakt-Panel.
// Ohne JavaScript sind alle Projekte sichtbar und die Filter versteckt (html[data-js]); src/scripts/filter.ts blendet aus.
import { getCollection } from "astro:content"
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import GalerieAkkordeon from "@/components/site/GalerieAkkordeon.astro"
import Knopf from "@/components/site/Knopf.astro"
import KontaktPanel from "@/components/site/KontaktPanel.astro"
import ProjektKarte from "@/components/site/ProjektKarte.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { DIGITAL_ART_KAPITEL } from "@/data/digital-art"
import { KONTAKT_EMAIL } from "@/data/kontakt"
import { slugVon } from "@/lib/blog"
import { ausgewaehlte, haeufigeThemen, weitereProjekte } from "@/lib/projekte"
import { kurzTitel, projektMeta, wirkungAusBeschreibung } from "@/lib/startseite"

// Figma: 4 Karten im Bento; alles Übrige steht in der Liste. Filter: Schlagwörter, die mindestens zwei Projekte tragen.
const BENTO_ANZAHL = 4
const FILTER_MINDESTENS = 2
const alle = await getCollection("projects")
const karten = ausgewaehlte(alle, BENTO_ANZAHL)
const weitere = weitereProjekte(alle, BENTO_ANZAHL)
const themen = haeufigeThemen(alle, FILTER_MINDESTENS)
const tagsAttr = (tags: string[]) => JSON.stringify(tags)
---

<SiteLayout
  title="Projekte — Patrick Schrödter"
  description="Werkzeuge, Systeme und Produkte: was ich gestalte und selbst baue."
  blatt="Übersicht"
>
  <div data-filter-root data-filter-einheit="Projekt|Projekte">
    <Seitenkopf
      art="seite"
      label="Arbeit"
      titel="Werkzeuge, Systeme und Produkte."
      einleitung="Was ich gestalte und selbst baue: Tools für Designer, Apps für den Alltag und Systeme, die Teams schneller machen."
    >
      {
        themen.length > 0 && (
          <div slot="zusatz" class="filter" data-filter-chips role="group" aria-label="Nach Thema filtern">
            <Knopf art="ghost" aria-pressed="true">Alle</Knopf>
            {themen.map((t) => (
              <Knopf art="ghost" aria-pressed="false" data-tag={t}>
                {t}
              </Knopf>
            ))}
          </div>
        )
      }
    </Seitenkopf>

    <div data-filter-liste>
      {
        karten.length > 0 && (
          <div data-gruppe>
            <Abschnitt id="ausgewaehlt" label="Ausgewählt" layout="oben">
              <div class="bento">
                {karten.map((p) => (
                  <div class="karte" data-eintrag data-slug={slugVon(p.id)} data-tags={tagsAttr(p.data.tags)}>
                    <ProjektKarte
                      format={p.data.format}
                      meta={projektMeta(p.data.tags, p.data.date)}
                      titel={kurzTitel(p.data.title)}
                      wirkung={p.data.wirkung ?? wirkungAusBeschreibung(p.data.description)}
                      bild={p.data.coverImage}
                      href={`/projects/${slugVon(p.id)}`}
                      slug={slugVon(p.id)}
                    />
                  </div>
                ))}
              </div>
            </Abschnitt>
          </div>
        )
      }
      {
        weitere.length > 0 && (
          <div data-gruppe>
            <Abschnitt id="weitere-projekte" label="Weitere Projekte" layout="links">
              <ul class="liste">
                {weitere.map((p) => (
                  <li class="eintrag" data-eintrag data-slug={slugVon(p.id)} data-tags={tagsAttr(p.data.tags)}>
                    <p class="text-label meta">{projektMeta(p.data.tags, p.data.date)}</p>
                    <h3 class="text-h3 titel">
                      <a href={`/projects/${slugVon(p.id)}`}>{kurzTitel(p.data.title)}</a>
                    </h3>
                    <p class="text-body beschreibung">{p.data.description}</p>
                  </li>
                ))}
              </ul>
            </Abschnitt>
          </div>
        )
      }
    </div>
    <p class="text-body leer" role="status" data-filter-leer></p>
  </div>

  <Abschnitt id="digital-art" label="Digital Art" layout="oben">
    <GalerieAkkordeon kapitel={DIGITAL_ART_KAPITEL} label="Digital Art" />
  </Abschnitt>

  <div class="kontakt">
    <KontaktPanel label="Kontakt" email={KONTAKT_EMAIL}>
      <Knopf slot="aktionen" art="ghost" href="/cv">Lebenslauf</Knopf>
    </KontaktPanel>
  </div>
</SiteLayout>

<style>
  /* Themenfilter: Knöpfe in einer umbrechenden Reihe (Abstand 8); ohne JavaScript ausgeblendet */
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--global-size-8);
  }
  :global(html:not([data-js])) .filter {
    display: none;
  }

  /* Der Seitenkopf sitzt bündig unter dem Kopf (Figma 267:21925): Abschnittsabstand oben von <main> aufheben */
  [data-filter-root] {
    margin-block-start: calc(-1 * var(--layout-section-gap));
  }

  /* Eintrag und Gruppe werden per hidden ausgeblendet; Karte, Zeile und Gruppe sind Raster und brauchen die Regel ausdrücklich */
  [data-eintrag][hidden],
  [data-gruppe][hidden] {
    display: none;
  }

  /* Bento (Figma 267:21984): Karten im 12er-Raster der Seite, mobil untereinander, Tablet zwei Spalten */
  .bento {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--layout-gutter);
    align-items: start;
  }
  .bento > * {
    grid-column: 1 / -1;
    min-width: 0;
  }

  /* Weitere Projekte (Figma 267:22020): Zeilen aus Meta, Titel und Beschreibung; mobil untereinander */
  .liste {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--global-size-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .eintrag {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--global-size-4);
    align-items: start;
    min-width: 0;
  }
  .meta,
  .titel,
  .beschreibung {
    grid-column: 1 / -1;
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .meta,
  .beschreibung {
    color: var(--theme-text-default);
  }
  .titel a {
    color: var(--theme-text-strong);
    text-decoration: none;
  }
  .titel a:hover {
    text-decoration: underline;
  }

  /* Statusmeldung bei 0 Treffern (leer, solange Projekte sichtbar sind; bleibt im Dokument für die Ansage) */
  .leer {
    margin: 0;
    color: var(--theme-text-default);
  }

  /* Kontakt: 80 Abstand zum Fuß (die Hauptfläche bringt schon den Abschnittsabstand mit) */
  .kontakt {
    margin-block-end: calc(var(--global-size-80) - var(--layout-section-gap));
  }

  @media (min-width: 768px) {
    /* Tablet: zwei Spalten mit 16 Abstand (Figma 267:22573), erste Karte über die volle Breite */
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--global-size-16);
    }
    .bento > * {
      grid-column: auto;
    }
    .bento > :first-child {
      grid-column: 1 / -1;
    }
    .meta {
      grid-column: 1 / span 2;
      grid-row: 1;
    }
    .titel {
      grid-column: 3 / span 3;
      grid-row: 1;
    }
    .beschreibung {
      grid-column: 6 / span 3;
      grid-row: 1;
    }
    .eintrag {
      column-gap: var(--layout-gutter);
    }
  }

  @media (min-width: 1024px) {
    /* Desktop: wieder im 12er-Raster (Karte 1: 8 Spalten, übrige 4); Liste in den 9 Spalten rechts: 2 + 3 + 4 */
    .bento {
      grid-template-columns: subgrid;
      column-gap: normal;
      row-gap: var(--layout-gutter);
    }
    .bento > * {
      grid-column: span 4;
    }
    .bento > :first-child {
      grid-column: span 8;
    }
    .beschreibung {
      grid-column: 6 / span 4;
    }
  }
</style>
