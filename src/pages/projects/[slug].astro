---
// Projektseite: Fallstudie (Projekte mit `fakten`, fünf Abschnitte) oder einfache Seite (alle übrigen).
// Der Text einer Fallstudie wird an den h2 geteilt und je Abschnitt als Markdown gesetzt (src/lib/fallstudie.ts, markdown.ts).
import { getCollection, render } from "astro:content"
import type { InferGetStaticPropsType } from "astro"
import ProjektLayout, { type FallstudieAbschnitt, type NaechstesProjekt } from "@/layouts/ProjektLayout.astro"
import { slugVon } from "@/lib/blog"
import { abschnittIds, assertFallstudie, teileAbschnitte } from "@/lib/fallstudie"
import { markdownZuHtml } from "@/lib/markdown"
import { naechstesProjekt } from "@/lib/projekte"
import { kurzTitel, projektMeta, wirkungAusBeschreibung } from "@/lib/startseite"

export async function getStaticPaths() {
  const projekte = await getCollection("projects")
  return projekte.map((project) => {
    const n = naechstesProjekt(projekte, slugVon(project.id))
    const naechstes: NaechstesProjekt | null = n
      ? {
          slug: slugVon(n.id),
          meta: projektMeta(n.data.tags, n.data.date),
          titel: kurzTitel(n.data.title),
          text: wirkungAusBeschreibung(n.data.description),
          bild: n.data.coverImage,
        }
      : null
    return { params: { slug: slugVon(project.id) }, props: { project, naechstes } }
  })
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { project, naechstes } = Astro.props as Props
const slug = slugVon(project.id)
const d = project.data

let abschnitte: FallstudieAbschnitt[] | undefined
let Content: Awaited<ReturnType<typeof render>>["Content"] | undefined
if (d.fakten) {
  const { einleitung, abschnitte: teile } = teileAbschnitte(project.body ?? "")
  try {
    assertFallstudie(teile.map((t) => t.titel))
    if (einleitung.trim()) throw new Error("Text vor dem ersten Abschnitt (h2) würde nicht angezeigt")
  } catch (e) {
    throw new Error(`projects/${slug}.md: ${(e as Error).message}`)
  }
  const ids = abschnittIds(teile.map((t) => t.titel))
  abschnitte = await Promise.all(teile.map(async (t, i) => ({ id: ids[i], titel: t.titel, html: await markdownZuHtml(t.markdown) })))
} else {
  ;({ Content } = await render(project))
}
---

<ProjektLayout
  title={d.title}
  description={d.description}
  date={d.date}
  tags={d.tags}
  coverImage={d.coverImage}
  {slug}
  url={d.url}
  repo={d.repo}
  fakten={d.fakten}
  kennzahlen={d.kennzahlen}
  {abschnitte}
  {naechstes}
>
  {Content && <Content />}
</ProjektLayout>
