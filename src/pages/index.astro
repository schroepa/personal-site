---
// Startseite im neuen Design (Figma 237:154, Screens 268:440 / 268:782 / 268:1085).
// Einstieg mit Lichtband · 02 Über mich · 03 Arbeit · 04 Digital Art · 05 Gedanken · 06 Kontakt.
// Die alte Fassung liegt unter docs/archiv/index-alt.astro (Löschung in Task 15).
import { getCollection } from "astro:content"
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import ArtikelZeile from "@/components/site/ArtikelZeile.astro"
import GalerieAkkordeon from "@/components/site/GalerieAkkordeon.astro"
import KontaktPanel from "@/components/site/KontaktPanel.astro"
import Knopf from "@/components/site/Knopf.astro"
import Lichtband from "@/components/site/Lichtband.astro"
import ProjektKarte from "@/components/site/ProjektKarte.astro"
import { KONTAKT_EMAIL } from "@/data/kontakt"
import { coverMittel, coverThumbSrc } from "@/lib/cover-image"
import { slugVon } from "@/lib/blog"
import { readingTime } from "@/lib/reading-time"
import { DIGITAL_ART_KAPITEL } from "@/data/digital-art"
import { ausgewaehlte, weitereProjekte } from "@/lib/projekte"
import {
  artikelMeta,
  kurzTitel,
  projektMeta,
  waehleGedanken,
  wirkungAusBeschreibung,
} from "@/lib/startseite"


// Bento (Figma: 4 Karten + „Außerdem“-Liste): ausgewählte Projekte (featured, nicht weitere), jüngste zuerst.
// Format und Wirkungszeile kommen aus dem Schema; ohne `wirkung` gilt der erste Satz der Beschreibung.
const BENTO_ANZAHL = 4
const AUSSERDEM_ANZAHL = 2
const alle = await getCollection("projects")
const karten = ausgewaehlte(alle, BENTO_ANZAHL)
const ausserdem = weitereProjekte(alle, BENTO_ANZAHL).slice(0, AUSSERDEM_ANZAHL)

// Gedanken: die jüngsten veröffentlichten Beiträge (1 groß, 2 klein)
const { gross, klein } = waehleGedanken(await getCollection("blog"))
const beitraege = [gross, ...klein].filter((b) => b !== undefined)

const kapitel = DIGITAL_ART_KAPITEL
---

<SiteLayout
  title="Patrick Schrödter — Design Engineer in Berlin"
  description="Design Engineer aus Berlin. Aufgewachsen mit Spraydosen, groß geworden mit Code."
  blatt="Einstieg"
>
  <div class="einstieg" id="einstieg" data-abschnitt="Einstieg">
    <Lichtband />
    <p class="text-label kopfzeile" data-anim="kicker">
      <span aria-hidden="true">→ </span>Design Engineer<span aria-hidden="true"> → </span>Berlin
    </p>
    <div class="aussage">
      <!-- Der Name der h1 ist immer der Endtext. Die Wörter sind für die Animation einzeln gefasst
           (data-anim). „Screens“ steht nicht im HTML: motion/durchstreichen.ts fügt es als aria-hidden-
           Dekoration ein (data-alt), nur mit Bewegung. -->
      <h1 class="text-hero titel">
        <span class="zeile"
          ><span class="wort" data-anim="wort">Ich</span> <span class="wort" data-anim="wort">entwerfe</span>
          <span class="ersatz" data-ersatz data-alt="Screens"
            ><span class="wort neu" data-anim="ersatz" data-neu>Systeme.</span></span
          ></span
        >
        <span class="zeile"
          ><span class="wort" data-anim="wort">Ich</span> <span class="wort" data-anim="wort">baue</span>
          <span class="wort" data-anim="wort">sie</span> <span class="wort" data-anim="wort">auch.</span></span
        >
      </h1>
      <p class="text-label scrollen" aria-hidden="true">Scrollen ↓</p>
    </div>
  </div>

  <Abschnitt id="ueber-mich" nummer="02" label="Über mich" layout="oben">
    <div class="ueber">
      <p class="text-signatur signatur" data-signatur>
        <span class="zeile"><span class="zeile-text" data-anim="zeile">Design Engineer.</span></span>
        <span class="zeile"><span class="zeile-text" data-anim="zeile">Berlin.</span></span>
        <span class="zeile"><span class="zeile-text" data-anim="zeile">15+ Jahre.</span></span>
      </p>
      <div class="text">
        <p class="text-body">
          Seit über 15 Jahren gestalte ich digitale Produkte an der Schnittstelle von Design und Code. Mein Weg führte
          mich von High-Growth E-Commerce (DefShop) und Corporate Innovation (Oetker Digital) bis zum Aufbau komplexer
          B2B-Plattformen und Super-Apps.
        </p>
        <p class="text-body">
          Ich spreche die Sprache der Entwicklung. Ob skalierbare Design Systems mit shadcn/ui und Tailwind CSS oder
          Design-Ops mit n8n und KI: Mein Ziel ist ein nahtloser Übergang vom Pixel zum produktiven Code.
        </p>
        <div class="aktion"><Knopf art="primary" href="/about">Mehr über mich</Knopf></div>
      </div>
      <p class="text-label stichworte">Systeme · Prozesse · Menschen · Pixel</p>
    </div>
  </Abschnitt>

  <Abschnitt id="arbeit" nummer="03" label="Arbeit" layout="oben">
    <div class="bento">
      {
        karten.map((p) => (
          <div class="karte" data-projekt={slugVon(p.id)}>
            <ProjektKarte
              format={p.data.format}
              meta={projektMeta(p.data.tags, p.data.date)}
              titel={kurzTitel(p.data.title)}
              wirkung={p.data.wirkung ?? wirkungAusBeschreibung(p.data.description)}
              bild={p.data.coverImage}
              href={`/projects/${slugVon(p.id)}`}
              slug={slugVon(p.id)}
            />
          </div>
        ))
      }
      <div class="weitere">
        {ausserdem.length > 0 && <p class="text-label meta">Außerdem</p>}
        {
          ausserdem.length > 0 && (
            <ul class="liste text-body">
              {ausserdem.map((p) => (
                <li>
                  <a href={`/projects/${slugVon(p.id)}`}>{kurzTitel(p.data.title)}</a>
                </li>
              ))}
            </ul>
          )
        }
        <div class="aktion"><Knopf art="primary" href="/projects">Alle Projekte</Knopf></div>
      </div>
    </div>
  </Abschnitt>

  <Abschnitt id="digital-art" nummer="04" label="Digital Art" layout="oben">
    <GalerieAkkordeon {kapitel} label="Digital Art" />
  </Abschnitt>

  <Abschnitt id="gedanken" nummer="05" label="Gedanken" layout="links">
    <div class="gedanken">
      {
        beitraege.map((b, i) => (
          <div data-beitrag={slugVon(b.id)}>
            <ArtikelZeile
              groesse={i === 0 ? "gross" : "klein"}
              meta={artikelMeta(b.data.tags, readingTime(b.body ?? ""), b.data.date)}
              titel={b.data.title}
              auszug={b.data.description}
              bild={i === 0 ? coverMittel(b.data.coverImage) : coverThumbSrc(b.data.coverImage)}
              href={`/blog/${slugVon(b.id)}`}
            />
          </div>
        ))
      }
      <div class="aktion"><Knopf art="primary" href="/blog">Alle Artikel</Knopf></div>
    </div>
  </Abschnitt>

  <div class="kontakt" id="kontakt">
    <KontaktPanel label="06 Kontakt" email={KONTAKT_EMAIL}>
      <Knopf slot="aktionen" art="ghost" href="/cv">Lebenslauf</Knopf>
    </KontaktPanel>
  </div>
</SiteLayout>

<style>
  /* Einstieg: bündig über die ganze Seitenbreite, direkt unter dem Kopf. Lichtband und Text liegen übereinander. */
  .einstieg {
    display: grid;
    margin-block-start: calc(-1 * var(--layout-section-gap));
    margin-inline: calc(-1 * var(--layout-margin));
  }
  .einstieg > :global(*) {
    grid-area: 1 / 1;
  }
  .kopfzeile {
    align-self: start;
    margin: 0;
    padding: var(--global-size-40) var(--layout-margin) 0;
    color: var(--theme-text-default);
    z-index: 1;
  }
  .aussage {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--global-size-20);
    padding: 0 var(--layout-margin) var(--global-size-64);
    z-index: 1;
  }
  .titel,
  .scrollen {
    margin: 0;
  }
  .titel {
    color: var(--theme-text-strong);
  }
  .zeile {
    display: block;
  }
  /* Wörter und Signatur-Zeilen sind einzeln beweglich (Transform braucht ein Box-Element) */
  .wort,
  .zeile-text {
    display: inline-block;
  }
  /* „Systeme.“ reserviert den Platz im Textfluss; das eingefügte „Screens“ (aria-hidden, nur mit Bewegung)
     liegt darüber, bis es ersetzt wird. Vom Skript erzeugte Elemente tragen nicht die Scope-Klasse, daher :global. */
  .ersatz {
    position: relative;
    display: inline-block;
  }
  .ersatz :global(.alt) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: inline-block;
    white-space: nowrap;
    color: var(--theme-text-default);
  }
  .ersatz :global(.alt-inhalt) {
    position: relative;
    display: inline-block;
  }
  /* Durchstreichen-Linie: mittig, Stärke aus dem Rahmen-Token */
  .ersatz :global(.strich) {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    height: var(--global-border-2);
    background: currentColor;
    transform-origin: left;
  }
  .scrollen {
    color: var(--theme-text-default);
  }

  /* Über mich: Signatur über 7 Spalten, Text über 5; Stichworte darunter */
  .ueber {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--global-size-40);
    align-items: start;
  }
  .ueber > * {
    grid-column: 1 / -1;
  }
  .signatur,
  .stichworte {
    margin: 0;
  }
  .signatur {
    color: var(--theme-text-strong);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-paragraph);
    color: var(--theme-text-default);
  }
  .text p {
    margin: 0;
  }
  .stichworte {
    color: var(--theme-text-default);
  }

  /* Bento: Karten und „Außerdem“-Liste im 12er-Raster (Figma 268:533) */
  .bento {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--layout-gutter);
    align-items: start;
  }
  .bento > * {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .weitere {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--global-size-12);
  }
  .weitere .meta {
    margin: 0;
    color: var(--theme-text-default);
  }
  .liste {
    display: flex;
    flex-direction: column;
    gap: var(--global-size-20);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .liste a {
    color: var(--theme-text-strong);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .liste a:hover {
    text-decoration: underline;
  }

  /* Gedanken: 40 Abstand zwischen den Zeilen, Knopf darunter */
  .gedanken {
    display: flex;
    flex-direction: column;
    gap: var(--global-size-40);
  }
  .gedanken > * {
    min-width: 0;
  }

  /* Kontakt: 80 Abstand zum Fuß (die Hauptfläche bringt schon den Abschnittsabstand mit) */
  .kontakt {
    margin-block-end: calc(var(--global-size-80) - var(--layout-section-gap));
  }

  @media (min-width: 768px) {
    .aussage {
      padding-bottom: var(--global-size-128);
    }
    .ueber .text {
      grid-column: 1 / span 6;
    }
    /* Tablet: zwei Spalten mit 16 Abstand (Figma 268:850) */
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--global-size-16);
    }
    .bento > * {
      grid-column: auto;
    }
    .bento > .karte:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .signatur {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .ueber .text {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .stichworte {
      grid-column: 1 / span 7;
      grid-row: 2;
    }
    /* Desktop: wieder im 12er-Raster der Seite (Karte 1: 8 Spalten, übrige 4) */
    .bento {
      grid-template-columns: subgrid;
      column-gap: normal;
      row-gap: var(--layout-gutter);
    }
    .bento > * {
      grid-column: span 4;
    }
    .bento > .karte:first-child {
      grid-column: span 8;
    }
  }
</style>
