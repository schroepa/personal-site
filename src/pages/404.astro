---
// Fehlerseite im neuen Design (Figma „Fehlerseite“ 270:1113, Screen seite-404 270:1410): Seitenkopf mit drei Wegen,
// darunter „Zuletzt geschrieben“ mit den zwei neuesten Artikeln (weniger Artikel: zeigen, was da ist; keiner: Block entfällt). noindex.
import { getCollection } from "astro:content"
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import ArtikelZeile from "@/components/site/ArtikelZeile.astro"
import Knopf from "@/components/site/Knopf.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { NAME } from "@/data/rechtliches"
import { slugVon, zeilenMeta } from "@/lib/blog"
import { coverThumbSrc } from "@/lib/cover-image"
import { zuletztGeschrieben } from "@/lib/fehlerseite"

const beitraege = zuletztGeschrieben(await getCollection("blog"))
---

<SiteLayout
  title={`Seite nicht gefunden — ${NAME}`}
  description="Diese Seite gibt es nicht. Vielleicht hat sich die Adresse geändert."
  blatt="01/01 Fehler"
  noindex
>
  <Seitenkopf
    art="seite"
    label="Fehler 404"
    titel="Diese Seite gibt es nicht."
    einleitung="Vielleicht hat sich die Adresse geändert, oder sie war nie da. Hier geht es weiter:"
  >
    <div slot="zusatz" class="wege">
      <Knopf art="primary" href="/">Zur Startseite</Knopf>
      <Knopf art="ghost" href="/projects">Arbeit</Knopf>
      <Knopf art="ghost" href="/blog">Gedanken</Knopf>
    </div>
  </Seitenkopf>

  {
    beitraege.length > 0 && (
      <Abschnitt id="zuletzt-geschrieben" label="Zuletzt geschrieben">
        <div class="zeilen">
          {beitraege.map((b) => (
            <ArtikelZeile
              groesse="klein"
              auszugAnzeigen={false}
              meta={zeilenMeta(b.data.tags, b.data.date)}
              titel={b.data.title}
              bild={coverThumbSrc(b.data.coverImage)}
              href={`/blog/${slugVon(b.id)}`}
            />
          ))}
        </div>
      </Abschnitt>
    )
  }
</SiteLayout>

<style>
  .wege {
    display: flex;
    flex-wrap: wrap;
    gap: var(--global-size-8);
  }
  .zeilen {
    display: flex;
    flex-direction: column;
    gap: var(--global-size-40);
  }
  .zeilen > :global(*) {
    min-width: 0;
  }
</style>
