---
// Datenschutzerklärung im neuen Design (Figma „Rechtliches“ 243:24, Screen datenschutz 265:21853). Sieben nummerierte Abschnitte,
// Texte und Platzhalter in src/data/rechtliches.ts (dort steht, was Patrick vor dem Livegang klärt).
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import Rechtstext from "@/components/site/Rechtstext.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { DATENSCHUTZ, NAME } from "@/data/rechtliches"
---

<SiteLayout
  title={`Datenschutz — ${NAME}`}
  description="Datenschutzerklärung: Hosting, Einwilligungsverwaltung mit Cookiebot, Reichweitenmessung mit PostHog und deine Rechte."
  blatt="02/02 Datenschutz"
>
  <Seitenkopf art="seite" label={DATENSCHUTZ.label} titel={DATENSCHUTZ.titel} einleitung={DATENSCHUTZ.einleitung} />
  {
    DATENSCHUTZ.abschnitte.map((a) => (
      <Abschnitt id={a.id} nummer={a.nummer} label={a.label}>
        <Rechtstext bloecke={a.bloecke} />
      </Abschnitt>
    ))
  }
</SiteLayout>
