---
// Grainy Gradient Generator im neuen Layout (Task 15b). Kein eigenes Figma-Design: Seitenkopf wie die anderen Seiten,
// darunter das Werkzeug (React nur für die Zustandslogik, Bedienelemente nativ, Styles in gradient-generator.css auf Tokens).
// Bleibt indexierbar (canonical und Open-Graph kommen aus SiteLayout; der frühere eigene Werkzeug-Layer ist weg).
//
// Keine Astro-Insel (client:load): die bringt Inline-Skripte mit, die die CSP blockiert (Task 16; Astros experimental.csp
// mit Hashes wäre möglich, null Inline-Skripte sind aber strenger und versionsunabhängig). Stattdessen rendert
// die Seite das Werkzeug hier auf dem Server und ein gebündeltes Skript hydriert es (src/scripts/gradient-generator-start.ts).
import { createElement } from "react"
import { renderToString } from "react-dom/server"
import SiteLayout from "@/layouts/SiteLayout.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import GradientGenerator from "@/components/GradientGenerator"
import { GRADIENT_GENERATOR_ID_PRAEFIX } from "@/scripts/gradient-generator-praefix"

const werkzeug = renderToString(createElement(GradientGenerator), { identifierPrefix: GRADIENT_GENERATOR_ID_PRAEFIX })
---

<SiteLayout
  title="Grainy Gradient Generator — Patrick Schrödter"
  description="Kostenloser Gradient Generator für weiche, körnige Farbverläufe. Presets anpassen, Farben und Formen steuern, als PNG exportieren."
  blatt="Gradient Generator"
>
  <Seitenkopf
    art="seite"
    label="Tool"
    titel="Grainy Gradient Generator"
    einleitung="Weiche, körnige Farbverläufe: Preset wählen, Farben und Formen anpassen und als PNG exportieren. Alles läuft in deinem Browser."
  />
  <noscript>
    <p class="text-body">Der Generator zeichnet im Browser und braucht JavaScript. Bitte aktiviere es, um Verläufe zu erstellen.</p>
  </noscript>
  <div class="gg-wurzel" data-gradient-generator-wurzel set:html={werkzeug} />
</SiteLayout>

<script>
  import { initGradientGenerator } from "@/scripts/gradient-generator-start"
  initGradientGenerator()
</script>

<style>
  /* Hülle für hydrateRoot: verhält sich wie die frühere <astro-island> (display: contents), das Layout bleibt gleich */
  .gg-wurzel {
    display: contents;
  }
</style>
