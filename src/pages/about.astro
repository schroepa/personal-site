---
// Über mich im neuen Design (Figma 269:2, Screens 269:524 / 269:855 / 269:1092; löst die alte Seite mit Foto ab).
// Seitenkopf · Haltung · Kompetenzen · Stationen · Werkzeuge · Kontakt-Panel, kein Foto. Texte: src/data/ueber-mich.ts.
// Person-JSON-LD liefert SiteLayout.
import SiteLayout from "@/layouts/SiteLayout.astro"
import Abschnitt from "@/components/site/Abschnitt.astro"
import Knopf from "@/components/site/Knopf.astro"
import KontaktPanel from "@/components/site/KontaktPanel.astro"
import NummernListe from "@/components/site/NummernListe.astro"
import Seitenkopf from "@/components/site/Seitenkopf.astro"
import { KONTAKT_EMAIL, LINKEDIN_URL } from "@/data/kontakt"
import { HALTUNG, KOMPETENZEN, STATIONEN, UEBER_MICH, WERKZEUGE } from "@/data/ueber-mich"
---

<SiteLayout
  title="Über mich — Patrick Schrödter"
  description="Design Engineer aus Berlin. Seit über 15 Jahren an der Schnittstelle von Design und Engineering."
  blatt="Über mich"
>
  <Seitenkopf art="seite" label={UEBER_MICH.label} titel={UEBER_MICH.titel} einleitung={UEBER_MICH.einleitung}>
    <div slot="zusatz" class="aktionen">
      <Knopf art="primary" href="/cv.pdf" target="_blank" rel="noopener" pfeil="↗" aria-label="Lebenslauf (PDF, öffnet in neuem Tab)">Lebenslauf</Knopf>
      <Knopf art="ghost" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" pfeil="↗" aria-label="LinkedIn (öffnet in neuem Tab)">LinkedIn</Knopf>
    </div>
  </Seitenkopf>

  <Abschnitt id="haltung" label="Haltung">
    <div class="haltung">
      {HALTUNG.map((absatz) => <p class="text-body absatz">{absatz}</p>)}
    </div>
  </Abschnitt>

  <Abschnitt id="kompetenzen" label="Kompetenzen">
    <NummernListe eintraege={KOMPETENZEN} ebene={3} />
  </Abschnitt>

  <Abschnitt id="stationen" label="Stationen">
    <NummernListe eintraege={STATIONEN} ebene={3} />
  </Abschnitt>

  <Abschnitt id="werkzeuge" label="Werkzeuge">
    <NummernListe eintraege={WERKZEUGE} />
  </Abschnitt>

  <KontaktPanel email={KONTAKT_EMAIL}>
    <Knopf slot="aktionen" art="ghost" href="/cv.pdf" target="_blank" rel="noopener" pfeil="↗" aria-label="Lebenslauf (PDF, öffnet in neuem Tab)">Lebenslauf</Knopf>
  </KontaktPanel>
</SiteLayout>

<style>
  .haltung {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-paragraph);
  }
  .absatz {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Fließtext höchstens 7 der 9 Spalten (wie in den übrigen Abschnitten) */
  @media (min-width: 1024px) {
    .haltung {
      grid-column: 1 / span 7;
    }
  }
  .aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--global-size-8);
  }
</style>
