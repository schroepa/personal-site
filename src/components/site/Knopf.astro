---
// Pillenknopf (Figma button: sm, pill; primary und ghost). Link, wenn href gesetzt ist, sonst <button type="button">.
// Die Ghost-Farbe lässt sich über --knopf-ghost-farbe überschreiben (z. B. auf der Farbfläche des Kontakt-Panels).
interface Props {
  art?: "primary" | "ghost"
  href?: string
  pfeil?: string
  [attr: string]: unknown
}
const { art = "primary", href, pfeil = "→", ...rest } = Astro.props
const klasse = `knopf knopf-${art} text-label`
---

{
  href ? (
    <a class={klasse} {href} {...rest}>
      <slot />
      <span aria-hidden="true">{pfeil}</span>
    </a>
  ) : (
    <button class={klasse} type="button" {...rest}>
      <slot />
      <span aria-hidden="true">{pfeil}</span>
    </button>
  )
}

<style>
  .knopf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--component-button-sm-gap);
    min-height: var(--component-button-sm-height);
    padding-inline: var(--component-button-sm-spacing-x);
    border: 0;
    border-radius: var(--component-button-radius-pill);
    font-family: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .knopf-primary {
    background: var(--component-button-primary-background-default);
    color: var(--component-button-primary-text-default);
  }
  .knopf-primary:hover {
    background: var(--component-button-primary-background-hover);
  }
  .knopf-primary:active {
    background: var(--component-button-primary-background-pressed);
  }

  .knopf-ghost {
    background: transparent;
    color: var(--knopf-ghost-farbe, var(--component-button-ghost-text-default));
  }
  .knopf-ghost:hover {
    background: var(--component-button-ghost-background-hover);
  }
  .knopf-ghost:active {
    background: var(--component-button-ghost-background-pressed);
  }
</style>
