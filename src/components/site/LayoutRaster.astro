---
// Layout-Raster: 12 Spaltenelemente, sichtbar sind so viele, wie --layout-columns vorgibt.
// Die übrigen landen in einer implizit angelegten Zeile der Höhe 0 und werden abgeschnitten.
const SPALTEN = 12
---

<div data-raster aria-hidden="true">
  {Array.from({ length: SPALTEN }, () => <div class="spalte" data-anim="spalte" />)}
</div>

<style>
  [data-raster] {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(var(--layout-columns), minmax(0, 1fr));
    grid-template-rows: 100%;
    grid-auto-rows: 0;
    column-gap: var(--layout-raster-spaltenabstand);
    row-gap: 0;
    padding-inline: var(--layout-raster-rand);
    max-width: var(--layout-raster-breite);
    margin-inline: auto;
  }

  /* Gepunktete Kanten: Punkt = --global-size-2, Lücke = --global-size-8 */
  .spalte {
    position: relative;
    min-height: 0;
    background-image:
      repeating-linear-gradient(
        to bottom,
        var(--layout-raster-linie-spalte) 0 var(--global-size-2),
        transparent var(--global-size-2) calc(var(--global-size-2) + var(--global-size-8))
      ),
      repeating-linear-gradient(
        to bottom,
        var(--layout-raster-linie-spalte) 0 var(--global-size-2),
        transparent var(--global-size-2) calc(var(--global-size-2) + var(--global-size-8))
      );
    background-size:
      var(--layout-raster-linie-staerke) 100%,
      var(--layout-raster-linie-staerke) 100%;
    background-position:
      left top,
      right top;
    background-repeat: no-repeat;
  }

  /* Farbe der Hervorhebung: hell die Textfarbe, dunkel eine mittlere Neutralstufe (volles Weiß lenkt auf dunklem Grund ab).
     Kein Figma-Token vorhanden; Primitive statt Literal. */
  [data-raster] {
    --raster-hover-farbe: var(--theme-text-default);
  }

  :global(:root[data-theme="dark"]) [data-raster] {
    --raster-hover-farbe: var(--global-color-neutral-600);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) [data-raster] {
      --raster-hover-farbe: var(--global-color-neutral-600);
    }
  }

  /* Hervorhebung unter dem Zeiger: eigene Ebene mit denselben Kanten in kräftigerer Farbe. Ihre Deckkraft
     (--spalte-an) treibt eine Feder in motion/raster-spalte.ts; ohne das Skript bleibt sie 0. */
  .spalte::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: var(--spalte-an, 0);
    background-image:
      repeating-linear-gradient(
        to bottom,
        var(--raster-hover-farbe) 0 var(--global-size-2),
        transparent var(--global-size-2) calc(var(--global-size-2) + var(--global-size-8))
      ),
      repeating-linear-gradient(
        to bottom,
        var(--raster-hover-farbe) 0 var(--global-size-2),
        transparent var(--global-size-2) calc(var(--global-size-2) + var(--global-size-8))
      );
    background-size:
      var(--layout-raster-linie-staerke) 100%,
      var(--layout-raster-linie-staerke) 100%;
    background-position:
      left top,
      right top;
    background-repeat: no-repeat;
  }
</style>
