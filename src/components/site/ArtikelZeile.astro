---
// Artikel-Zeile (Figma 260:352): Titel ist der Link (h3 > a), die ganze Zeile per ::after klickbar, Bild dekorativ.
// gross: Bild links (5 von 9 Spalten), Text rechts; klein: schmales Bild, Meta und Titel.
interface Props {
  groesse: "gross" | "klein"
  meta: string
  titel: string
  auszug?: string
  href: string
}
const { groesse, meta, titel, auszug, href } = Astro.props
---

<article class:list={["artikel-zeile", `artikel-zeile-${groesse}`]}>
  <div class="bild" data-bild></div>
  <div class="text" data-text>
    <p class="text-label meta">{meta}</p>
    <h3 class="text-h3 titel"><a {href}>{titel}</a></h3>
    {groesse === "gross" && auszug && <p class="text-body auszug">{auszug}</p>}
    {groesse === "gross" && <p class="text-body mehr" aria-hidden="true">Artikel lesen →</p>}
  </div>
</article>

<style>
  .artikel-zeile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--artikel-zeile-abstand) var(--artikel-zeile-spaltenabstand);
  }

  .bild {
    background: var(--artikel-zeile-bild-flaeche);
    corner-shape: squircle;
  }
  .artikel-zeile-gross .bild {
    height: var(--artikel-zeile-bild-hoehe-mobil);
    border-radius: var(--artikel-zeile-bild-radius-gross);
  }
  .artikel-zeile-klein .bild {
    height: var(--artikel-zeile-bild-hoehe-mobil-klein);
    border-radius: var(--artikel-zeile-bild-radius-klein);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--artikel-zeile-text-abstand);
    min-width: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .meta,
  .titel,
  .auszug,
  .mehr {
    margin: 0;
  }
  .meta {
    color: var(--artikel-zeile-meta-farbe);
  }
  .titel {
    color: var(--artikel-zeile-titel-farbe);
  }
  .auszug {
    color: var(--artikel-zeile-text-farbe);
  }
  .mehr {
    color: var(--artikel-zeile-titel-farbe);
  }

  .titel a {
    color: inherit;
    text-decoration: none;
  }
  .titel a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .titel a:focus-visible {
    outline: none;
  }
  .artikel-zeile:has(a:focus-visible) {
    outline: var(--global-border-2) solid var(--theme-border-focus);
    outline-offset: var(--global-size-4);
  }

  /* Ab Tablet: 9 Spalten, Bild links, Text rechts */
  @media (min-width: 768px) {
    .artikel-zeile {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      align-items: start;
    }
    .artikel-zeile-gross .bild {
      grid-column: 1 / span 5;
      height: var(--artikel-zeile-bild-hoehe-gross);
    }
    .artikel-zeile-gross .text {
      grid-column: 6 / span 4;
    }
    .artikel-zeile-klein .bild {
      grid-column: 1 / span 2;
      height: var(--artikel-zeile-bild-hoehe-klein);
    }
    .artikel-zeile-klein .text {
      grid-column: 3 / span 7;
    }
  }
</style>
