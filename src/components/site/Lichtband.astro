---
// Lichtband (Figma 268:488, Einstieg der Startseite): Hülle für den WebGL-Shader (Task 14).
// Das Canvas ist dekorativ (aria-hidden). Ohne Shader (kein JavaScript, WebGL fehlt) bleibt der statische
// Verlauf als Fallback stehen. Die Höhe ist über Tokens reserviert (Figma: 640 mobil, 720 Tablet, 800 Desktop),
// damit der Shader keinen Layoutsprung auslöst. Deckkraft aus dem Token, dunkel 50 %.
---

<div class="lichtband" data-lichtband-huelle>
  <canvas data-lichtband aria-hidden="true"></canvas>
</div>

<style>
  .lichtband {
    position: relative;
    height: var(--global-size-640);
    overflow: hidden;
    pointer-events: none;
  }

  /* Statischer Fallback: zwei weiche Farbflächen aus den Orange-Tokens, die in die Seitenfläche auslaufen */
  .lichtband::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 30%, var(--global-color-orange-350), transparent 60%),
      radial-gradient(ellipse at 30% 40%, var(--global-color-orange-200), transparent 55%);
    opacity: var(--lichtband-deckkraft);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 768px) {
    .lichtband {
      height: var(--global-size-720);
    }
  }
  @media (min-width: 1440px) {
    .lichtband {
      height: var(--global-size-800);
    }
  }
</style>
