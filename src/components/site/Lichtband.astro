---
// Lichtband (Figma 268:488, Einstieg der Startseite): Hülle für den WebGL-Shader (Task 14).
// Das Canvas ist dekorativ (aria-hidden). Ohne Shader (kein JavaScript, WebGL fehlt) bleibt der statische
// Verlauf als Fallback stehen. Die Höhe ist über Tokens reserviert (Figma: 640 mobil, 720 Tablet, 800 Desktop),
// damit der Shader keinen Layoutsprung auslöst. Deckkraft aus dem Token, dunkel 50 %.
// Der Shader (src/scripts/lichtband.ts) zeichnet ins Canvas; Mischmodus (hell multiply, dunkel screen) und Maske
// stehen hier. Der Startzustand (unsichtbar bis zum ersten Bild) kommt über data-anim aus neu-bewegung.css.
---

<div class="lichtband" data-lichtband-huelle>
  <canvas data-lichtband data-anim="lichtband" aria-hidden="true"></canvas>
</div>

<style>
  .lichtband {
    position: relative;
    height: var(--global-size-640);
    overflow: hidden;
    pointer-events: none;
  }

  /* Statischer Fallback: zwei weiche Farbflächen aus den Orange-Tokens, die in die Seitenfläche auslaufen */
  .lichtband::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 30%, var(--global-color-orange-350), transparent 60%),
      radial-gradient(ellipse at 30% 40%, var(--global-color-orange-200), transparent 55%);
    opacity: var(--lichtband-deckkraft);
  }

  /* Blendet das Canvas ein (data-einblenden, setzt das Skript nur bei frischer Ankunft), geht der Verlauf mit derselben Dauer aus */
  .lichtband[data-einblenden]::before {
    transition: opacity var(--motion-lichtband-einblenden) var(--motion-easing-blenden);
  }

  .lichtband[data-aktiv]::before {
    opacity: 0;
  }

  /*
   * Maske aus dem Prototyp (docs/reference/atmosphaere.js): oben 0 → 28 %, voll bis 60 %, aus bei 88 %; seitlich je 16 %.
   * Figma hat dafür keine Tokens; die Prozentwerte sind Gestaltung des Prototyps und stehen nur hier.
   * Mischmodus: hell multiply, dunkel screen (CSS kann ihn nicht aus einer Zahl wählen, deshalb nach Theme).
   */
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: var(--lichtband-deckkraft);
    mix-blend-mode: multiply;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, black 28%, black 60%, transparent 88%),
      linear-gradient(to right, transparent 0%, black 16%, black 84%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, transparent 0%, black 28%, black 60%, transparent 88%),
      linear-gradient(to right, transparent 0%, black 16%, black 84%, transparent 100%);
    mask-composite: intersect;
  }

  :global(:root[data-theme="dark"]) canvas {
    mix-blend-mode: screen;
  }

  /* Ohne JavaScript (kein data-theme): Systemeinstellung */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) canvas {
      mix-blend-mode: screen;
    }
  }

  @media (min-width: 768px) {
    .lichtband {
      height: var(--global-size-720);
    }
  }
  @media (min-width: 1440px) {
    .lichtband {
      height: var(--global-size-800);
    }
  }
</style>
